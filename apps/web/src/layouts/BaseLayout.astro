---
import "../styles/global.css";
import BreakingNewsTicker from "../components/BreakingNewsTicker";
import { ClientRouter } from "astro:transitions";
import { useTranslations, localizePath } from "../lib/i18n";

const { title = "La Lliga del Sobresalt", activeTab = "RANKING", lang = "ca" } = Astro.props;
const assetBase = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const publicAsset = (path: string) => `${assetBase}${path.replace(/^\/+/, "")}`;

const t = useTranslations(lang);
const disclaimer = t("disclaimer");
const slogan = t("slogan");
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={disclaimer} />

    <style is:global>
      html {
        scroll-behavior: smooth;
      }
    </style>

    <!-- Meta tags for premium SEO -->
    <link rel="icon" type="image/png" href={publicAsset("favicon.png")} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#020617" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={disclaimer} />
    <meta property="og:type" content="website" />

    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="bg-[#020617] text-slate-100 antialiased selection:bg-amber-500/30 selection:text-amber-200 min-h-screen flex flex-col justify-between overflow-x-hidden pb-14">
    <!-- Skip link for keyboard users -->
    <a href="#main-content" class="skip-link">{lang === "en" ? "Skip to main content" : "Saltar al contingut principal"}</a>

    <!-- Interactive Spotlight -->
    <div class="spotlight" id="mouse-spotlight"></div>

    <!-- Header: Sticky Premium Sports HUD Navbar -->
    <header class="sticky top-0 z-40 w-full border-b border-slate-900 bg-slate-950/80 backdrop-blur-md sobresalt-layout-header">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 md:py-3 select-none sobresalt-layout-nav">

        {/* LOGO & SLOGAN */}
        <a href={localizePath("./", lang)} class="flex items-center gap-3.5 group shrink-0 sobresalt-layout-logo">
          <div class="relative flex h-14 w-14 items-center justify-center rounded-xl overflow-hidden bg-slate-950 border border-amber-500/30 group-hover:scale-105 transition-all duration-300 shadow-[0_0_20px_rgba(245,158,11,0.2)]">
            <img src={publicAsset("images/logo_emblem_new.png")} alt="Logo" class="h-full w-full object-cover scale-110" />
            <div class="scanner-line"></div>
          </div>
          <div class="flex flex-col">
            <span class="text-lg font-black uppercase tracking-tight font-display bg-gradient-to-r from-amber-500 via-white to-amber-500 bg-[size:200%_auto] bg-clip-text text-transparent group-hover:animate-text-gradient">
              La Lliga
            </span>
            <span class="text-[10px] font-black uppercase tracking-[0.2em] font-display text-slate-400 group-hover:text-amber-400 transition-colors -mt-1.5">
              Del Sobresalt
            </span>
          </div>
          {/* Subtitle / Slogan (hidden on mobile) */}
          <div class="hidden lg:block h-6 w-[1px] bg-slate-900 mx-1"></div>
          <p class="hidden lg:block text-[9px] text-slate-500 font-bold max-w-[210px] leading-tight">
            {slogan}
          </p>
        </a>

        {/* NAVIGATION LINKS - visible on all sizes, scrollable on mobile */}
        <nav aria-label={lang === "en" ? "Main navigation" : "Navegació principal"} class="hidden lg:flex items-center gap-1 text-[10px] font-black uppercase tracking-wider sobresalt-layout-nav-links">
          {[
            { name: "RANKING", href: localizePath("./", lang) },
            { name: "JORNADES", href: localizePath("./#jornades", lang) },
            { name: "CIUTATS", href: localizePath("temporades/", lang) },
            { name: "INCIDENTS", href: localizePath("incidents/", lang) },
            { name: "REGLAMENT", href: localizePath("reglament/", lang) },
            { name: "SOBRE EL PROJECTE", href: localizePath("premsa/", lang) },
          ].map((item) => {
            const isActive = activeTab === item.name;
            return (
              <a
                href={item.href}
                data-tab-name={item.name}
                aria-current={isActive ? "page" : undefined}
                class={`px-3.5 py-2.5 rounded-lg font-display tracking-widest transition-all nav-tab-link sobresalt-layout-nav-link ${
                  isActive
                    ? "text-amber-500 border-b-2 border-amber-500 rounded-b-none bg-amber-500/5 active-tab"
                    : "text-slate-400 hover:text-slate-200 hover:bg-slate-900/40"
                }`}
              >
                {t(`nav.${item.name.toLowerCase().replace("sobre el projecte", "sobre")}` as any)}
              </a>
            );
          })}
        </nav>

        {/* NAVIGATION RIGHT (Controls) */}
        <div class="flex items-center gap-3 shrink-0">
          <!-- Glassmorphic language selector pill -->
          <div role="radiogroup" aria-label={lang === "en" ? "Language selector" : "Selector d'idioma"} class="relative flex items-center p-1 rounded-xl bg-slate-900/40 border border-slate-900 shadow-inner sobresalt-layout-lang-selector">
            {(["ca", "es", "en"] as const).map((locale) => {
              const active = lang === locale;
              const targetUrl = localizePath(Astro.url.pathname, locale);
              return (
                <a
                  href={targetUrl}
                  class={`relative z-10 px-2.5 py-1 text-[10px] font-black tracking-wider transition-all duration-300 rounded-lg ${
                    active
                      ? "text-amber-500 bg-amber-500/10 shadow-[0_0_12px_rgba(245,158,11,0.2)] border border-amber-500/20"
                      : "text-slate-500 hover:text-slate-300 border border-transparent"
                  }`}
                >
                  {locale.toUpperCase()}
                </a>
              );
            })}
          </div>

          <div class="hidden sm:flex h-10 items-center gap-3 px-4 rounded-xl border border-slate-900 bg-slate-950/50">
            <div class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-green-500 animate-pulse"></span>
              <span class="text-[9px] font-black text-slate-400">{t("nav.datacenter")}</span>
            </div>
          </div>
        </div>
      </nav>
    </header>

    <!-- Mobile nav strip (horizontal scrollable) -->
    <nav aria-label={lang === "en" ? "Mobile navigation" : "Navegació mòbil"} class="lg:hidden flex w-full overflow-x-auto border-b border-slate-900 bg-slate-950/60 backdrop-blur-md select-none z-30 scrollbar-none sobresalt-layout-mobile-nav">
      <div class="flex items-center gap-0.5 px-3 py-2 text-[9px] font-black uppercase tracking-wider mx-auto">
        {[
          { name: "RANKING", href: localizePath("./", lang) },
          { name: "JORNADES", href: localizePath("./#jornades", lang) },
          { name: "CIUTATS", href: localizePath("temporades/", lang) },
          { name: "INCIDENTS", href: localizePath("incidents/", lang) },
          { name: "REGLAMENT", href: localizePath("reglament/", lang) },
          { name: "SOBRE EL PROJECTE", href: localizePath("premsa/", lang) },
        ].map((item) => {
          const isActive = activeTab === item.name;
          return (
            <a
              href={item.href}
              data-tab-name={item.name}
              aria-current={isActive ? "page" : undefined}
              class={`shrink-0 px-2.5 py-1.5 rounded-lg font-display tracking-widest transition-all nav-tab-link sobresalt-layout-nav-link ${
                isActive
                  ? "text-amber-500 bg-amber-500/10"
                  : "text-slate-500 hover:text-slate-200 hover:bg-slate-900/40"
              }`}
            >
              {t(`nav.${item.name.toLowerCase().replace("sobre el projecte", "sobre")}` as any)}
            </a>
          );
        })}
      </div>
    </nav>

    <!-- Main Content Container -->
    <main id="main-content" role="main" tabindex="-1" class="flex-1 mx-auto w-full max-w-7xl px-4 py-6 md:py-8 relative z-10 sobresalt-layout-main focus:outline-none">
      <slot />
    </main>

    <!-- Footer: Responsive sports HUD disclaimer footer -->
    <footer class="w-full border-t border-slate-900 bg-slate-950/40 py-6 md:py-8 text-xs font-semibold text-slate-500 mb-10 relative z-10 sobresalt-layout-footer">
      <div class="mx-auto max-w-7xl px-4 flex flex-col gap-6 md:flex-row md:items-center md:justify-between select-none">
        {/* Disclaimer Left */}
        <div class="flex items-start gap-2.5 max-w-xl">
          <span class="text-base select-none shrink-0 mt-0.5 text-amber-500/80">⚠️</span>
          <p class="leading-relaxed text-[10px] text-slate-500 font-medium">
            {disclaimer}
          </p>
        </div>

        {/* Links & Socials Right */}
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6 md:shrink-0">
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-[10px] uppercase font-bold tracking-wider">
            <a href={localizePath("reglament/", lang)} class="hover:text-slate-300 transition-colors">{t("label.rules")}</a>
            <span class="text-slate-800">•</span>
            <a href={localizePath("premsa/", lang)} class="hover:text-slate-300 transition-colors">{t("label.methodology")}</a>
            <span class="text-slate-800">•</span>
            <a href={localizePath("premsa/", lang)} class="hover:text-slate-300 transition-colors">{t("label.sources")}</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Breaking News Ticker component -->
    <BreakingNewsTicker client:only="preact" lang={lang} />

    <script is:inline>
      // Interactive Mouse Spotlight
      document.addEventListener('mousemove', (e) => {
        const spotlight = document.getElementById('mouse-spotlight');
        if (spotlight) {
          spotlight.style.setProperty('--x', `${e.clientX}px`);
          spotlight.style.setProperty('--y', `${e.clientY}px`);
        }
      });

      // E-sports HUD navigation tab reactive controllers
      document.addEventListener('DOMContentLoaded', () => {
        const tabs = document.querySelectorAll('.nav-tab-link');
        const activeClass = ['text-amber-500', 'border-b-2', 'border-amber-500', 'rounded-b-none', 'bg-amber-500/5', 'active-tab'];
        const inactiveClass = ['text-slate-400', 'hover:text-slate-200', 'hover:bg-slate-900/40'];

        function setActiveTab(name) {
          tabs.forEach(tab => {
            if (tab.getAttribute('data-tab-name') === name) {
              tab.classList.add(...activeClass);
              tab.classList.remove(...inactiveClass);
            } else {
              tab.classList.remove(...activeClass);
              tab.classList.add(...inactiveClass);
            }
          });
        }

        // Intercept clicks on JORNADES tab to scroll smoothly
        const jLink = document.querySelector('[data-tab-name="JORNADES"]');
        if (jLink) {
          jLink.addEventListener('click', (e) => {
            const target = document.getElementById('jornades');
            if (target) {
              e.preventDefault();
              target.scrollIntoView({ behavior: 'smooth' });
              history.pushState(null, '', '#jornades');
              setActiveTab('JORNADES');
            }
          });
        }

        // IntersectionObserver to auto-highlight tabs as user scrolls
        const target = document.getElementById('jornades');
        if (target && 'IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                setActiveTab('JORNADES');
              } else {
                // If JORNADES leaves viewport, fall back to RANKING if we are on the dashboard
                const cleanPath = window.location.pathname.replace(/^\/(es|en)(\/|$)/, "/");
                const isHome = cleanPath === '/' || cleanPath.endsWith('index.html') || cleanPath.includes('/ranking');
                if (isHome) {
                  setActiveTab('RANKING');
                }
              }
            });
          }, { threshold: 0.15, rootMargin: '-10% 0px -60% 0px' });
          observer.observe(target);
        }
      });
    </script>
  </body>
</html>
