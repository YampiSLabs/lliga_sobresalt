---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Radio, Database, CheckCircle } from "lucide-preact";
import type { LanguageCode } from "../lib/i18n";
import { useTranslations } from "../lib/i18n";

interface Props {
  lang: LanguageCode;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const textLabel = {
  ca: "FEEDS HOMOLOGATS",
  es: "FEEDS HOMOLOGADOS",
  en: "APPROVED FEEDS",
}[lang] || "FEEDS HOMOLOGATS";

const textTitle = {
  ca: "MITJANS HOMOLOGATS",
  es: "MEDIOS HOMOLOGADOS",
  en: "APPROVED MEDIA",
}[lang] || "MITJANS HOMOLOGATS";

const textScraping = {
  ca: "SISTEMA DE SCRAPING:",
  es: "SISTEMA DE SCRAPING:",
  en: "SCRAPING SYSTEM:",
}[lang] || "SISTEMA DE SCRAPING:";

const textDescription = {
  ca: "Aquesta és la <strong>Whitelist oficial</strong> de portals i diaris informatius des dels quals el nostre motor d'intel·ligència artificial (VAR-IA) analitza, filtra i processa titulars de successos de forma autònoma per a l'assignació de punts a la classificació. Tots els mitjans llistats compleixen amb els estàndards mediàtics d'homologació humorística.",
  es: "Esta es la <strong>Whitelist oficial</strong> de portales y diarios informativos desde los cuales nuestro motor de inteligencia artificial (VAR-IA) analiza, filtra y procesa titulares de sucesos de forma autónoma para la asignación de puntos a la clasificación. Todos los medios listados cumplen con los estándares mediáticos de homologación humorística.",
  en: "This is the official <strong>Whitelist</strong> of news outlets and portals from which our artificial intelligence engine (VAR-IA) autonomously analyzes, filters, and processes incident headlines to assign points to the leaderboard. All listed outlets meet the media standards for humorous homologation.",
}[lang] || "";

const textSection = {
  ca: "SECCIÓ",
  es: "SECCIÓN",
  en: "SECTION",
}[lang] || "SECCIÓ";

const textReliability = {
  ca: "FIABILITAT",
  es: "FIABILIDAD",
  en: "RELIABILITY",
}[lang] || "FIABILITAT";

const textProcessed = {
  ca: "NOTÍCIES PROCESSADES",
  es: "NOTICIAS PROCESADAS",
  en: "PROCESSED NEWS",
}[lang] || "NOTÍCIES PROCESSADES";

const WHITELISTED_MEDIA = [
  {
    name: "El Caso",
    section: { ca: "Successos / Policial", es: "Sucesos / Policial", en: "Incidents / Police" }[lang],
    processedCount: 2482,
    status: "Actiu",
    feedType: "RSS",
    reliability: { ca: "Alta absurtat", es: "Alto absurdo", en: "High absurdity" }[lang],
  },
  {
    name: "Diari de Tarragona",
    section: { ca: "Local / Camp de Tarragona", es: "Local / Camp de Tarragona", en: "Local / Tarragona Region" }[lang],
    processedCount: 914,
    status: "Actiu",
    feedType: "RSS",
    reliability: { ca: "Alta absurtat", es: "Alto absurdo", en: "High absurdity" }[lang],
  },
  {
    name: "Segre",
    section: { ca: "Ponent / Comarques Lleida", es: "Poniente / Comarcas Lleida", en: "West / Lleida Region" }[lang],
    processedCount: 681,
    status: "Actiu",
    feedType: "RSS / Web Scraping",
    reliability: { ca: "Estable", es: "Estable", en: "Stable" }[lang],
  },
  {
    name: "Betevé",
    section: { ca: "Metropolitana / Barcelona", es: "Metropolitana / Barcelona", en: "Metropolitan / Barcelona" }[lang],
    processedCount: 1530,
    status: "Actiu",
    feedType: "RSS / Web Scraping",
    reliability: { ca: "Estable", es: "Estable", en: "Stable" }[lang],
  },
  {
    name: "El Nacional",
    section: { ca: "Successos / Política", es: "Sucesos / Política", en: "Incidents / Politics" }[lang],
    processedCount: 1845,
    status: "Actiu",
    feedType: "RSS",
    reliability: { ca: "Alta absurtat", es: "Alto absurdo", en: "High absurdity" }[lang],
  },
  {
    name: "Diari de Girona",
    section: { ca: "Local / Comarques Gironines", es: "Local / Comarcas Gironines", en: "Local / Girona Region" }[lang],
    processedCount: 524,
    status: "Actiu",
    feedType: "RSS",
    reliability: { ca: "Estable", es: "Estable", en: "Stable" }[lang],
  }
];
---

<BaseLayout title={`${t("nav.sobre")} · La Lliga del Sobresalt`} activeTab="SOBRE EL PROJECTE" lang={lang}>
  <div class="space-y-8 max-w-6xl mx-auto">
    <!-- Header section -->
    <div class="flex flex-col md:flex-row md:items-center justify-between border-b border-slate-900 pb-4 gap-4 select-none">
      <div class="space-y-1">
        <span class="font-mono text-[9px] text-slate-500 font-extrabold uppercase tracking-widest">{textLabel}</span>
        <h1 class="text-3xl font-black font-display text-white uppercase tracking-tight flex items-center gap-2">
          <Radio class="h-6 w-6 text-amber-500 animate-pulse" />
          {textTitle}
        </h1>
      </div>
      <div class="flex items-center gap-2 text-[10px] text-slate-500 font-mono">
        <span>{textScraping}</span>
        <span class="text-green-400 font-bold flex items-center gap-1">
          <span class="h-1.5 w-1.5 rounded-full bg-green-500 animate-pulse"></span>
          ONLINE
        </span>
      </div>
    </div>

    <!-- Description HUD -->
    <div class="hud-panel p-5 rounded-xl bg-slate-950/30 border border-slate-900/40 text-xs text-slate-400 leading-relaxed font-medium" set:html={textDescription}>
    </div>

    <!-- Grid Layout -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
      {WHITELISTED_MEDIA.map((media) => (
        <div class="hud-panel p-5 rounded-2xl bg-slate-950/20 border border-slate-900/60 flex flex-col justify-between min-h-[220px] relative overflow-hidden group hover:border-amber-500/30 transition-all duration-300 hover:scale-[1.01] hover:shadow-[0_0_15px_rgba(245,158,11,0.06)]">
          <div class="absolute inset-0 hud-grid opacity-5 pointer-events-none"></div>

          {/* Header Card */}
          <div class="flex items-start justify-between">
            <div class="space-y-1">
              <span class="inline-flex items-center gap-1 text-[8px] font-mono font-black text-amber-500 uppercase tracking-widest bg-amber-500/5 px-2 py-0.5 rounded border border-amber-500/20">
                {media.feedType}
              </span>
              <h2 class="text-lg font-black text-white font-display uppercase tracking-tight mt-1">{media.name}</h2>
            </div>

            <span class="h-5 w-5 rounded-full bg-green-500/10 border border-green-500/30 flex items-center justify-center text-green-400">
              <CheckCircle class="h-3.5 w-3.5" />
            </span>
          </div>

          {/* Section details */}
          <div class="my-3 space-y-1.5 select-none font-mono text-[10px] text-slate-400">
            <div class="flex justify-between">
              <span class="text-slate-500">{textSection}:</span>
              <span class="text-slate-300 font-bold truncate max-w-[150px]">{media.section}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-500">{textReliability}:</span>
              <span class="text-slate-300 font-bold">{media.reliability}</span>
            </div>
          </div>

          {/* Footer Card: Processed counts */}
          <div class="border-t border-slate-900/60 pt-3 flex items-center justify-between mt-auto">
            <div>
              <span class="block font-mono text-[8px] text-slate-500 uppercase font-black">{textProcessed}</span>
              <span class="text-lg font-black font-mono text-amber-500 tracking-tight">{media.processedCount}</span>
            </div>
            <span class="text-[9px] font-mono text-slate-500 font-bold flex items-center gap-1">
              <Database class="h-3 w-3 text-slate-500" />
              HUD LIVE
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
