---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getAvailableCities, getCityShieldSrc } from "../lib/cityShields";
import { Calendar, Shield, Trophy } from "lucide-preact";
import { getSeasons } from "../lib/api";
import type { LanguageCode } from "../lib/i18n";
import { localizePath, useTranslations } from "../lib/i18n";

interface Props {
  lang: LanguageCode;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const seasons = await getSeasons(lang);
const cities = getAvailableCities();

const defender = seasons.find((s) => s.status === "Finalitzada" && s.winner) || seasons[0];
const lastWinnerShield = defender?.winner ? getCityShieldSrc(defender.winner.slug) : null;

const text = {
  telemetry: { ca: "ARXIU TELEMETRIC", es: "ARCHIVO TELEMETRICO", en: "TELEMETRIC ARCHIVE" }[lang],
  title: { ca: "HISTORIAL DE TEMPORADES", es: "HISTORIAL DE TEMPORADAS", en: "SEASONS HISTORY" }[lang],
  championDef: { ca: "CAMPIO DEFENSOR", es: "CAMPEON DEFENSOR", en: "DEFENDING CHAMPION" }[lang],
  provisionalLeader: { ca: "LIDER PROVISIONAL", es: "LIDER PROVISIONAL", en: "PROVISIONAL LEADER" }[lang],
  officialWinner: { ca: "GUANYADOR OFICIAL", es: "GANADOR OFICIAL", en: "OFFICIAL WINNER" }[lang],
  editions: { ca: "EDICIONS DE LA LLIGA", es: "EDICIONES DE LA LIGA", en: "LEAGUE EDITIONS" }[lang],
  monitoredCities: { ca: "MUNICIPIS MONITORITZATS", es: "MUNICIPIOS MONITORIZADOS", en: "MONITORED MUNICIPALITIES" }[lang],
  monitoredCount: { ca: "MUNICIPIS ACTIUS", es: "MUNICIPIOS ACTIVOS", en: "ACTIVE MUNICIPALITIES" }[lang],
  activeStatus: { ca: "Activa", es: "Activa", en: "Active" }[lang],
  finishedStatus: { ca: "Finalitzada", es: "Finalizada", en: "Finished" }[lang],
  finalPoints: { ca: "PUNTS FINALS", es: "PUNTOS FINALES", en: "FINAL POINTS" }[lang],
  accumulatedPoints: { ca: "PUNTS ACUMULATS", es: "PUNTOS ACUMULADOS", en: "ACCUMULATED POINTS" }[lang],
  provisionalPodium: { ca: "PODI PROVISIONAL", es: "PODIO PROVISIONAL", en: "PROVISIONAL PODIUM" }[lang],
  seasonPodium: { ca: "PODI DE LA TEMPORADA", es: "PODIO DE LA TEMPORADA", en: "SEASON PODIUM" }[lang],
  roundsRegistered: { ca: "JORNADES REGISTRADES:", es: "JORNADAS REGISTRADAS:", en: "REGISTERED ROUNDS:" }[lang],
  completed: { ca: "COMPLETADES", es: "COMPLETADAS", en: "COMPLETED" }[lang],
  emptyTitle: { ca: "Sense temporades publicades", es: "Sin temporadas publicadas", en: "No published seasons" }[lang],
  emptySub: {
    ca: "Quan el backend publiqui temporades, apareixeran aqui.",
    es: "Cuando el backend publique temporadas, apareceran aqui.",
    en: "When the backend publishes seasons, they will appear here.",
  }[lang],
  noIncidents: { ca: "Competicio iniciant-se", es: "Competicion iniciandose", en: "Competition starting" }[lang],
  noIncidentsSub: { ca: "Sense incidents registrats", es: "Sin incidentes registrados", en: "No registered incidents" }[lang],
};

function getDefenderDesc() {
  if (!defender) return "";
  const points = defender.winner?.points || 0;
  if (defender.status === "Finalitzada") {
    return {
      ca: `Guanyador oficial de la temporada amb ${points} punts acumulats.`,
      es: `Ganador oficial de la temporada con ${points} puntos acumulados.`,
      en: `Official season winner with ${points} accumulated points.`,
    }[lang];
  }
  return {
    ca: `Liderant actualment la competicio amb ${points} punts acumulats.`,
    es: `Liderando actualmente la competicion con ${points} puntos acumulados.`,
    en: `Currently leading the competition with ${points} accumulated points.`,
  }[lang];
}
---

<BaseLayout title={`${t("nav.ciutats")} · La Lliga del Sobresalt`} activeTab="CIUTATS" lang={lang}>
  <div class="space-y-8 max-w-6xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-center justify-between border-b border-slate-900 pb-4 gap-4 select-none">
      <div class="space-y-1">
        <span class="font-mono text-[9px] text-slate-500 font-extrabold uppercase tracking-widest">{text.telemetry}</span>
        <h1 class="text-3xl font-black font-display text-white uppercase tracking-tight flex items-center gap-2">
          <Trophy class="h-6 w-6 text-amber-500" />
          {text.title}
        </h1>
      </div>
      <div class="flex items-center gap-2 text-[10px] text-slate-400 font-mono">
        <span class="rounded bg-slate-900 border border-slate-800 px-2.5 py-1 font-bold text-amber-500">LIVE STATS</span>
      </div>
    </div>

    {defender && (
      <div class="relative overflow-hidden rounded-2xl border border-amber-500/50 bg-gradient-to-br from-slate-950 via-slate-900/60 to-amber-950/20 p-6 md:p-8 flex flex-col md:flex-row items-center justify-between gap-6 shadow-[0_0_30px_rgba(245,158,11,0.12)]">
        <div class="absolute inset-0 bg-radial-gradient from-amber-500/5 to-transparent pointer-events-none"></div>
        <div class="flex flex-col sm:flex-row items-center gap-6 z-10 text-center sm:text-left">
          {lastWinnerShield ? (
            <img src={lastWinnerShield} alt="" class="h-24 w-24 object-contain drop-shadow-[0_0_20px_rgba(245,158,11,0.4)] animate-bounce" style="animation-duration: 4s;" />
          ) : (
            <div class="h-24 w-24 rounded-full bg-amber-500/10 border border-amber-500/30 flex items-center justify-center font-bold text-amber-400">
              {defender.winner?.name.substring(0, 3).toUpperCase() || "LL"}
            </div>
          )}
          <div class="space-y-2">
            <span class="inline-flex items-center gap-1 font-mono text-[9px] font-black bg-amber-500/20 border border-amber-500/40 text-amber-400 px-2 py-0.5 rounded uppercase">
              {defender.status === "Finalitzada" ? text.championDef : text.provisionalLeader}
            </span>
            <h2 class="text-3xl md:text-5xl font-black font-display text-white uppercase tracking-tighter leading-none">
              {defender.winner?.name || "Sense dades"}
            </h2>
            <p class="text-xs text-slate-400 font-medium">{getDefenderDesc()}</p>
          </div>
        </div>

        <div class="flex items-center gap-8 border-t md:border-t-0 md:border-l border-slate-800/80 pt-6 md:pt-0 md:pl-8 z-10 justify-around w-full md:w-auto">
          <div class="text-center md:text-left">
            <span class="block font-mono text-[8px] text-slate-500 uppercase font-black">{t("label.season")}</span>
            <span class="text-2xl font-black font-mono text-white tracking-tight">
              {defender.name.replace("Temporada ", "").replace("Season ", "")}
            </span>
          </div>
          <div class="text-center md:text-left">
            <span class="block font-mono text-[8px] text-slate-500 uppercase font-black">{defender.status === "Finalitzada" ? text.finalPoints : text.accumulatedPoints}</span>
            <span class="text-2xl font-black font-mono text-amber-500">{defender.winner?.points || 0} PTS</span>
          </div>
        </div>
      </div>
    )}

    <section class="space-y-4">
      <div class="flex items-end justify-between gap-4 border-b border-slate-900 pb-3">
        <h2 class="text-xs font-black font-mono tracking-widest text-slate-400 uppercase">{text.monitoredCities}</h2>
        <span class="font-mono text-[9px] font-black text-amber-500 uppercase">{cities.length} {text.monitoredCount}</span>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
        {cities.map((city) => {
          const shield = getCityShieldSrc(city.slug);
          const content = (
            <>
              {shield ? (
                <img src={shield} alt="" class="h-10 w-10 object-contain shrink-0" loading="lazy" />
              ) : (
                <div class="h-10 w-10 rounded bg-slate-900 border border-slate-800 flex items-center justify-center shrink-0">
                  <Shield class="h-5 w-5 text-slate-600" />
                </div>
              )}
              <span class="min-w-0">
                <span class="block text-[11px] font-black text-slate-200 uppercase leading-tight group-hover:text-white">{city.name}</span>
                <span class="block text-[9px] font-mono text-slate-500 uppercase mt-1">{city.province || "Catalunya"}</span>
              </span>
            </>
          );
          return (
            <a
              href={localizePath(`/ciutat/${city.slug}/`, lang)}
              class={`group min-h-20 rounded-lg border border-slate-900/80 p-3 flex items-center gap-3 hover:border-amber-500/40 hover:bg-slate-900/40 transition-colors ${
                city.hasShield ? "bg-slate-950/30" : "bg-slate-950/20"
              }`}
            >
              {content}
            </a>
          );
        })}
      </div>
    </section>

    <div class="space-y-4">
      <h3 class="text-xs font-black font-mono tracking-widest text-slate-400 uppercase">{text.editions}</h3>
      {seasons.length ? (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {seasons.map((season) => {
            const winnerShield = season.winner ? getCityShieldSrc(season.winner.slug) : null;
            return (
              <div class="hud-panel p-6 rounded-2xl bg-slate-950/20 border border-slate-900/60 flex flex-col justify-between min-h-[300px] relative overflow-hidden group">
                <div class="absolute inset-0 hud-grid opacity-5 pointer-events-none"></div>
                <div class="flex items-center justify-between border-b border-slate-900 pb-3 mb-4">
                  <div class="flex items-center gap-2">
                    <Calendar class="h-4.5 w-4.5 text-amber-500" />
                    <span class="font-extrabold text-sm text-slate-200 tracking-tight">{season.name}</span>
                  </div>
                  <span class={`font-mono text-[8px] font-black uppercase border rounded px-1.5 py-0.5 ${
                    season.status === "Activa"
                      ? "text-emerald-400 bg-emerald-500/10 border-emerald-500/30"
                      : "text-slate-500 bg-slate-900 border-slate-800/80"
                  }`}>
                    {season.status === "Activa" ? text.activeStatus : text.finishedStatus}
                  </span>
                </div>

                {season.winner ? (
                  <div class="flex items-center gap-4 my-auto bg-slate-950/30 border border-slate-900/60 p-4 rounded-xl">
                    {winnerShield ? (
                      <img src={winnerShield} alt="" class="h-12 w-12 object-contain" />
                    ) : (
                      <div class="h-12 w-12 rounded bg-slate-900 flex items-center justify-center font-bold text-slate-400">
                        {season.winner.name.substring(0, 3).toUpperCase()}
                      </div>
                    )}
                    <div>
                      <span class="block font-mono text-[8px] text-slate-500 uppercase font-black">
                        {season.status === "Activa" ? text.provisionalLeader : text.officialWinner}
                      </span>
                      <span class="text-xl font-black text-white uppercase font-display">{season.winner.name}</span>
                      <span class="block text-[11px] font-mono font-bold text-amber-500">+{season.winner.points} PTS</span>
                    </div>
                  </div>
                ) : (
                  <div class="flex items-center justify-center my-auto bg-slate-950/30 border border-slate-900/60 p-6 rounded-xl text-center">
                    <div>
                      <Shield class="h-8 w-8 text-slate-700 mx-auto mb-2" />
                      <span class="block text-[10px] font-mono font-bold text-slate-500 uppercase tracking-widest">{text.noIncidents}</span>
                      <span class="block text-[9px] font-mono text-slate-600">{text.noIncidentsSub}</span>
                    </div>
                  </div>
                )}

                {season.podium && season.podium.length > 0 && (
                  <div class="mt-4 pt-4 border-t border-slate-900/60 space-y-2">
                    <span class="block font-mono text-[8px] text-slate-500 uppercase font-black mb-2">
                      {season.status === "Activa" ? text.provisionalPodium : text.seasonPodium}
                    </span>
                    <div class="grid grid-cols-3 gap-2 text-center text-[10px]">
                      {season.podium.map((row) => (
                        <div class="bg-slate-950/40 border border-slate-900/60 rounded-lg py-2 px-1">
                          <span class={`block font-black text-xs ${row.pos === 1 ? "text-amber-400" : row.pos === 2 ? "text-slate-300" : "text-amber-700"}`}>
                            {row.pos}
                          </span>
                          <span class="block font-bold truncate text-slate-300 uppercase">{row.name}</span>
                          <span class="block font-mono text-[9px] text-slate-500">{row.points} PTS</span>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                {season.rounds && season.rounds.length > 0 && (
                  <div class="mt-3 pt-3 border-t border-slate-900/60 flex items-center justify-between text-[8px] font-mono text-slate-500 select-none">
                    <span>{text.roundsRegistered} {season.rounds.length}</span>
                    <span class="text-slate-400">{season.rounds.filter((r) => r.status === "closed").length} {text.completed}</span>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      ) : (
        <div class="rounded-2xl border border-slate-900 bg-slate-950/30 p-10 text-center">
          <Shield class="h-10 w-10 text-slate-700 mx-auto mb-3" />
          <h2 class="font-display text-xl font-black text-slate-300 uppercase">{text.emptyTitle}</h2>
          <p class="mt-2 text-sm text-slate-500">{text.emptySub}</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
