---
import CityDetailPageTemplate from "../../templates/CityDetailPageTemplate.astro";
import { getAvailableCityPageSlugs } from "../../lib/cityShields";

export async function getStaticPaths() {
  return getAvailableCityPageSlugs().map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
---

<CityDetailPageTemplate slug={slug!} lang="ca" />
