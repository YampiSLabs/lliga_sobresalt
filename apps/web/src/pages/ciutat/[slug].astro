---
import CityDetailPageTemplate from "../../templates/CityDetailPageTemplate.astro";
import { getAvailableCityShields } from "../../lib/cityShields";

export async function getStaticPaths() {
  return getAvailableCityShields().map((city) => ({
    params: { slug: city.slug },
  }));
}

const { slug } = Astro.params;
---

<CityDetailPageTemplate slug={slug!} lang="ca" />
