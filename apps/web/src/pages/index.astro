---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getIncidents, getRanking } from "../lib/api";
import Dashboard from "../components/Dashboard.tsx";

const [ranking, incidents] = await Promise.all([getRanking(), getIncidents()]);
---

<BaseLayout>
  <Dashboard initialRanking={ranking} initialIncidents={incidents} client:load />
</BaseLayout>
